{
    "env": {
        "browser": true,
        "es2021": true,
        "jquery": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:vue/vue3-essential",
        "prettier"
    ],
    "overrides": [
    ],
    "parserOptions": {
        "ecmaVersion": "latest"
    },
    "plugins": [
        "vue"
    ],
    "rules": {
        "vue/no-side-effects-in-computed-properties": "off",
        "vue/multi-word-component-names": "off"
    },
    "globals": {
        "Vue": "readable"
    }
}
